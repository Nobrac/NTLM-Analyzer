<?xml version="1.0" encoding="utf-8"?>
<!--
  NTLM-Analyzer agent - Windows Installer package (WiX v4/v5).

  Two ways in, one definition:

    * double-click        - a wizard asks for the collector URL and API key
    * msiexec /qn         - the same values arrive as properties, for Intune
                            or any other unattended rollout

  Division of labour: the MSI owns the payload and the service entry, the agent
  only writes its configuration. That is why the custom action calls
  `ntlm-agent.exe configure` and not `install` - `install` would copy the EXE a
  second time and create a service the installer does not know about, leaving
  an orphan behind on uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="NTLM-Analyzer Agent"
           Manufacturer="NTLM-Analyzer"
           Version="$(var.ProductVersion)"
           UpgradeCode="8f3d1c5e-6a24-4f77-9d2b-1c0e5a7b4e91"
           Scope="perMachine"
           Compressed="yes">

    <!-- Upgrades replace in place; the config file survives because it lives in
         ProgramData and is never a component of this package. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of the NTLM-Analyzer agent is already installed." />

    <Launch Condition="Installed OR (VersionNT64 &gt;= 600)"
            Message="This agent requires 64-bit Windows." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Shown in Apps & features and on the installer's own dialogs. The .ico
         carries nine sizes so Windows never has to scale one up. -->
    <Icon Id="AgentIcon" SourceFile="$(var.IconFile)" />

    <!-- WixUI's stock artwork replaced with the product's own. Sizes are fixed
         by the UI: 493x58 for the header strip, 493x312 for the welcome and
         finish pages. -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />
    <!-- Without this the licence page shows WiX's placeholder text. Generated
         from LICENSE at build time so the two cannot drift apart. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />

    <!-- ============================================================ -->
    <!-- Properties. Public (upper-case) so msiexec can set them:          -->
    <!--   msiexec /i ntlm-agent.msi /qn COLLECTORURL=https://... APIKEY=x -->
    <!-- ============================================================ -->
    <Property Id="COLLECTORURL" Value="https://" />
    <!-- Optional. Hidden keeps it out of the property dump in a log, and the
         custom action that writes the configuration hides its command line
         (HideTarget), so a verbose install log does not carry the key either.
         On an msiexec command line it is still visible to anyone who can list
         processes while it runs. For unattended rollouts see the agent README:
         install without the key, then set it with the configure command and
         its api-key-env option. -->
    <Property Id="APIKEY" Secure="yes" Hidden="yes" />
    <!-- 1 = accept an http:// collector URL. Without TLS the API key and every
         reported logon cross the network in clear text, so it has to be asked
         for explicitly. -->
    <Property Id="ALLOWHTTP" Value="0" Secure="yes" />
    <Property Id="INTERVAL" Value="15" />
    <!-- 1 = also switch outgoing NTLM auditing on. Off by default: it writes to
         the machine's policy, which an admin may want to control centrally. -->
    <Property Id="ENABLEAUDIT" Value="0" />

    <Property Id="ARPPRODUCTICON" Value="AgentIcon" />
    <!-- ARPNOMODIFY is not declared here: WixUI_InstallDir already sets it,
         and Property ids must be unique across the whole package. -->
    <Property Id="ARPHELPLINK" Value="https://github.com/Nobrac/NTLM-Analyzer" />

    <!-- Shown on the last page of the wizard. The one thing the installer
         deliberately does not do is the one thing worth saying at the end. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="The NtlmAgent service is running and reporting. Settings can be changed later with: ntlm-agent.exe configure --collector-url ... --api-key ..." />

    <!-- ============================================================ -->
    <!-- Payload and service                                              -->
    <!-- ============================================================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NtlmAgent" />
    </StandardDirectory>

    <ComponentGroup Id="AgentFiles" Directory="INSTALLFOLDER">
      <Component Id="AgentExeComponent" Bitness="always64">
        <File Id="AgentExe" Source="$(var.AgentExe)" KeyPath="yes" />

        <!-- The service is declared here rather than created by the agent, so
             Windows Installer tracks it and removes it again on uninstall. -->
        <ServiceInstall Id="AgentService"
                        Name="NtlmAgent"
                        DisplayName="NTLM-Analyzer Agent"
                        Description="Collects NTLM usage data and reports it to the NTLM-Analyzer collector."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="service"
                        Vital="yes">
          <!-- Restart on failure: a collector that is briefly unreachable makes
               the agent exit; without this the machine would silently stop
               reporting until someone noticed. -->
          <util:ServiceConfig FirstFailureActionType="restart"
                              SecondFailureActionType="restart"
                              ThirdFailureActionType="restart"
                              RestartServiceDelayInSeconds="60" />
        </ServiceInstall>

        <!-- Stop before uninstall, start after install - but only once the
             configuration has been written (see the sequencing below). -->
        <ServiceControl Id="AgentServiceControl"
                        Name="NtlmAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="NTLM-Analyzer Agent" Level="1">
      <ComponentGroupRef Id="AgentFiles" />
    </Feature>

    <!-- ============================================================ -->
    <!-- Custom actions: write config, then start the service             -->
    <!-- ============================================================ -->

    <!-- Optional switches, set only when asked for. An unset property formats
         to nothing, so the command line simply does not carry them. -->
    <SetProperty Id="AUDITFLAG" Value="--enable-outgoing-audit" Before="InstallInitialize"
                 Sequence="execute" Condition="ENABLEAUDIT = &quot;1&quot;" />
    <SetProperty Id="HTTPFLAG" Value="--allow-http" Before="InstallInitialize"
                 Sequence="execute" Condition="ALLOWHTTP = &quot;1&quot;" />

    <!-- Runs the installed agent itself to write the configuration. Earlier
         versions went through the WiX QuietExec helper, which logged the whole
         command line, API key included, into a verbose install log.
         HideTarget keeps Windows Installer from logging this command line.
         Deferred and not impersonated: it runs as SYSTEM after the files are
         in place, so it can create and lock down the data folder. -->
    <CustomAction Id="WriteConfig"
                  FileRef="AgentExe"
                  ExeCommand="configure --collector-url &quot;[COLLECTORURL]&quot; --api-key &quot;[APIKEY]&quot; --interval [INTERVAL] [AUDITFLAG] [HTTPFLAG]"
                  Execute="deferred"
                  Impersonate="no"
                  HideTarget="yes"
                  Return="check" />

    <!-- http:// is refused unless ALLOWHTTP=1 - the agent refuses it too, but
         this says so before anything is installed. -->
    <CustomAction Id="NoHttps" Error="The collector URL uses http:// - the API key and all findings would travel unencrypted. Use https://, or add ALLOWHTTP=1 to accept that." />

    <!-- A missing collector URL is a broken install, not a warning: the service
         would start and fail forever. Catch it in both UI and silent mode. -->
    <!-- The mandatory-URL check lives in the *execute* sequence, not in a
         Launch condition. A Launch condition is evaluated in the UI sequence as
         well, before the first dialog is usable, so it aborted a double-click
         before the user could type the URL it was asking for. Gating it on
         UILevel did not help either.
         By the time InstallExecuteSequence runs, the wizard has already set
         COLLECTORURL - so the interactive path passes and only a silent install
         without the property is stopped, with a message that says how. -->
    <CustomAction Id="NoCollectorUrl" Error="No collector URL was supplied. Run: msiexec /i ntlm-agent.msi /qn COLLECTORURL=https://collector.example.local:8443" />

    <InstallExecuteSequence>
      <Custom Action="NoCollectorUrl" Before="InstallInitialize"
              Condition="NOT Installed AND (NOT COLLECTORURL OR COLLECTORURL = &quot;https://&quot;)" />
      <Custom Action="NoHttps" Before="InstallInitialize"
              Condition="NOT Installed AND COLLECTORURL ~&gt;&lt; &quot;http://&quot; AND ALLOWHTTP &lt;&gt; &quot;1&quot;" />
      <!-- After the files are on disk, before the service is started. -->
      <Custom Action="WriteConfig" After="InstallFiles" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <!-- ============================================================ -->
    <!-- Wizard                                                            -->
    <!-- ============================================================ -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <UI>
      <!-- Slot the settings page between the licence and the folder page. -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next"
               Event="NewDialog" Value="AgentSettingsDlg"
               Condition="LicenseAccepted = &quot;1&quot;" Order="3" />
      <Publish Dialog="InstallDirDlg" Control="Back"
               Event="NewDialog" Value="AgentSettingsDlg" Order="3" />

      <Dialog Id="AgentSettingsDlg" Width="370" Height="270"
              Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Collector connection" />
        <!-- Width stops at 305 units: the mark in the banner bitmap starts at
             about 330 once its pixel position is scaled to dialog units, and a
             wider description ran straight under it. -->
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="20"
                 Transparent="yes" NoPrefix="yes"
                 Text="Where this machine sends what it finds. Nothing else is changed." />
        <!-- A Bitmap control takes the id of a Binary row, not a localisation
             variable. WixUI_Bmp_Banner is the one WixUIBannerBmp replaces, so
             this picks up our own artwork. -->
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="UrlLabel" Type="Text" X="20" Y="60" Width="290" Height="12"
                 NoPrefix="yes" Text="Collector URL" />
        <Control Id="UrlEdit" Type="Edit" X="20" Y="73" Width="330" Height="18"
                 Property="COLLECTORURL" Indirect="no" />
        <Control Id="UrlHint" Type="Text" X="20" Y="93" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="Example: https://collector.example.local:8443 - use HTTPS, otherwise the API key travels in clear text." />

        <Control Id="KeyLabel" Type="Text" X="20" Y="118" Width="290" Height="12"
                 NoPrefix="yes" Text="API key (optional)" />
        <!-- Password="yes" masks the field while typing. -->
        <Control Id="KeyEdit" Type="Edit" X="20" Y="131" Width="330" Height="18"
                 Property="APIKEY" Password="yes" Indirect="no" />
        <Control Id="KeyHint" Type="Text" X="20" Y="151" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="Leave empty if the collector runs without an API key. It then checks none." />

        <Control Id="IntervalLabel" Type="Text" X="20" Y="178" Width="290" Height="12"
                 NoPrefix="yes" Text="Poll interval in minutes" />
        <Control Id="IntervalEdit" Type="Edit" X="20" Y="191" Width="60" Height="18"
                 Property="INTERVAL" Indirect="no" />

        <Control Id="AuditCheck" Type="CheckBox" X="20" Y="214" Width="330" Height="18"
                 Property="ENABLEAUDIT" CheckBoxValue="1"
                 Text="Switch on outgoing NTLM auditing on this machine" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="InstallDirDlg"
                   Condition="COLLECTORURL AND COLLECTORURL &lt;&gt; &quot;https://&quot; AND NOT (COLLECTORURL ~&gt;&lt; &quot;http://&quot; AND ALLOWHTTP &lt;&gt; &quot;1&quot;)" />
          <Publish Event="SpawnDialog" Value="UrlMissingDlg"
                   Condition="NOT COLLECTORURL OR COLLECTORURL = &quot;https://&quot;" />
          <Publish Event="SpawnDialog" Value="HttpDlg"
                   Condition="COLLECTORURL ~&gt;&lt; &quot;http://&quot; AND ALLOWHTTP &lt;&gt; &quot;1&quot;" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="HttpDlg" Width="260" Height="95" Title="[ProductName] Setup">
        <Control Id="Text" Type="Text" X="20" Y="12" Width="220" Height="50"
                 NoPrefix="yes" Text="The collector URL starts with http://, so the API key and all findings would travel unencrypted. Please use https://. (For a test lab without TLS: msiexec with ALLOWHTTP=1.)" />
        <Control Id="OK" Type="PushButton" X="100" Y="68" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <Dialog Id="UrlMissingDlg" Width="260" Height="85" Title="[ProductName] Setup">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="35"
                 NoPrefix="yes" Text="Please enter the collector URL before continuing." />
        <Control Id="OK" Type="PushButton" X="100" Y="57" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
  </Package>
</Wix>
